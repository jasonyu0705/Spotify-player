#pragma once

// Copy this file to include/secrets.h and fill it in. secrets.h is git-ignored.

// WiFi: the ESP32 only sees 2.4 GHz networks.
#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// From developer.spotify.com/dashboard -> your app -> Settings.
#define SPOTIFY_CLIENT_ID "your-client-id"
#define SPOTIFY_CLIENT_SECRET "your-client-secret"

// Run `python3 tools/get_refresh_token.py` on your laptop and paste the result.
#define SPOTIFY_REFRESH_TOKEN "your-refresh-token"

// Pi mode: tools/configure_pi.py sets these and writes the Pi's private env file.
// Build/flash with `pio run -e controller-pi -t upload`.
#define PI_SERVER_URL "http://raspberrypi.local:8765"
#define PI_API_TOKEN "your-generated-pi-api-token"
